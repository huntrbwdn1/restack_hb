<?xml version="1.0" encoding="UTF-8"?>
<!--
  Restack - Outlook add-in manifest (template).
  The Id stays the same as Thread Attachments, the add-in's old name, so Outlook treats it as the same add-in.
  Don't install this file directly. The add-in's page (index.html) and its "Share install file"
  button fill in the web address it's hosted at ({{BASE}}) and the team key ({{QUERY}}).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  <Id>50f0be95-347e-4d26-9255-72cc5191b9f0</Id>
  <Version>0.25.1.0</Version>
  <ProviderName>Restack</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Restack"/>
  <Description DefaultValue="See every attachment in an email thread, preview them, and combine the ones you pick into one PDF."/>
  <IconUrl DefaultValue="{{BASE}}icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE}}icon-128.png"/>
  <SupportUrl DefaultValue="{{BASE}}"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE}}taskpane.html{{QUERY}}"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE}}taskpane.html{{QUERY}}"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- Reading several selected emails at once (multi-select) needs this level. -->
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <!-- Reading emails: the "Restack" button opens the side panel. -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="taReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="taReadButton">
                    <Label resid="ReadButton.Label"/>
                    <Supertip>
                      <Title resid="ReadButton.Label"/>
                      <Description resid="ReadButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                      <SupportsMultiSelect>true</SupportsMultiSelect>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Writing an email: the "Attach PDF" button adds a PDF made with "Put in new email". -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="taComposeGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="taComposeButton">
                    <Label resid="ComposeButton.Label"/>
                    <Supertip>
                      <Title resid="ComposeButton.Label"/>
                      <Description resid="ComposeButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{{BASE}}icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{{BASE}}icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{{BASE}}icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="{{BASE}}commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="{{BASE}}taskpane.html{{QUERY}}"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Restack"/>
          <bt:String id="ReadButton.Label" DefaultValue="Restack"/>
          <bt:String id="ComposeButton.Label" DefaultValue="Attach PDF"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ReadButton.Tooltip" DefaultValue="List every attachment in the selected thread, preview them, and combine the ones you pick into one PDF."/>
          <bt:String id="ComposeButton.Tooltip" DefaultValue="Attach the combined PDF you made with Restack to this email."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
